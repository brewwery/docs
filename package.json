  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "patch-package": "8.0.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "4.6.7",
    "@xmldom/xmldom": "0.9.12",
    "katex": "0.18.2"
